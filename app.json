{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fittrack",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F14",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.klipbit.fittrack",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSUbiquitousContainers": {
          "iCloud.com.klipbit.fittrack": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerSupportedFolderLevels": "Any",
            "NSUbiquitousContainerName": "FitTrack"
          }
        }
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.klipbit.fittrack",
          "iCloud.com.klipbit.fittrack"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments",
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.klipbit.fittrack",
          "iCloud.com.klipbit.fittrack"
        ]
      }
    },
    "android": {
      "package": "com.klipbit.fittrack",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "FitTrack uses the camera for weekly progress photos and meal photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTrack imports progress photos, meal photos and Nike Run Club screenshots from your library."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "FitTrack creates a dedicated calendar with your planned workouts and cardio."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf2998ef-bec1-49d9-b04b-67161fb9d696"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cf2998ef-bec1-49d9-b04b-67161fb9d696"
    }
  }
}
